# ALADIN configuration reference
# Copy to data/.env and fill in your values. NEVER commit data/.env.
# Every value has a sane default; empty = default.

# ── Broker (MetaTrader5) ────────────────────────────────────────────────
EXCHANGE_ID=exness
MT5_LOGIN=                 # your MT5 login number
MT5_PASSWORD=              # your MT5 password
MT5_SERVER=                # e.g. Exness-MT5Real  /  Exness-MT5Trial7
MT5_PATH=                  # optional: full path to terminal64.exe
EXCHANGE_MARKET_TYPE=forex # forex | crypto | synthetic
MARGIN_MODE=hedging

# ── Trading lists ───────────────────────────────────────────────────────
DAY_SYMBOLS=EURUSDm,GBPUSDm
NIGHT_SYMBOLS=AUDJPYm,CHFJPYm

# ── Risk ────────────────────────────────────────────────────────────────
MAX_RISK_PER_TRADE_PCT=2.0     # % of equity risked per trade (hard cap)
MAX_DAILY_LOSS_PCT=            # e.g. 5  -> "5%" of equity (preferred)
MAX_DAILY_LIMIT=20$            # flat $ fallback if no PCT key set
DAILY_PROFIT_TARGET=30$
MAX_DRAWDOWN_PCT=50.0          # stop trading below this drawdown from peak
MAX_OPEN_POSITIONS=4
MAX_GROUP_RISK_PCT=8.0         # max combined risk of one currency group
MAX_POSITION_SIZE_USD=10000

# ── Signal quality gates ────────────────────────────────────────────────
MIN_CONFIDENCE=0.60            # forex entry gate
MIN_RR=1.5                     # minimum realized risk:reward
TP_TARGET_RR=1.5               # raw TP distance (before liquidity capping)
FVG_ENTRY_TOLERANCE=2.0        # how far past the FVG price may still qualify
MIN_FVG_GAP_PCT=0.0002         # minimum FVG size as fraction of price
MIN_ADX=0                      # 4h trend-strength filter (0 = off)
HTF_ZONE_FILTER=true           # reject bullish-in-premium / bearish-in-discount
SL_BUFFER_ATR_MULT=0.75        # stop-loss buffer in ATR multiples

# ── Crypto tuning (BTC/ETH/SOL/...) ─────────────────────────────────────
CRYPTO_MIN_CONFIDENCE=0.45
CRYPTO_TP_TARGET_RR=1.5
CRYPTO_FVG_ENTRY_TOLERANCE=2.0
CRYPTO_MIN_FVG_GAP_PCT=0.0001
CRYPTO_SL_BUFFER_ATR_MULT=0.75
CRYPTO_MIN_RR=1.0
CRYPTO_HTF_ZONE_FILTER=false
CRYPTO_ENTRY_TF=1h
CRYPTO_MARKET_ENTRY_CONF=0.65  # >= this: take crypto at market, skip the limit
CRYPTO_LOT_MULTIPLIER=1.0

# ── Metals tuning (XAU/XAG/...) — experimental, forward-test first ─────
METAL_MIN_CONFIDENCE=0.35
METAL_TP_TARGET_RR=2.0
METAL_FVG_ENTRY_TOLERANCE=3.0
METAL_MIN_FVG_GAP_PCT=0.0001
METAL_SL_BUFFER_ATR_MULT=0.75
METAL_MIN_RR=1.0
METAL_HTF_ZONE_FILTER=false

# ── Trade management ────────────────────────────────────────────────────
TSL_HALF_RISK_R=0.4            # move SL to -0.5R after +0.4R
TSL_CHANDELIER_R_MULT=1.5      # R-based trailing distance
LIMIT_EXPIRY_HOURS=2           # auto-cancel stale pending limits (0 = never)
PENDING_CANCEL_DISTANCE_PCT=0.3
MOMENTUM_BE_R=0.5              # tighten SL to BE after momentum flip >= R
COOLDOWN_HOURS=2               # no re-entry on a symbol after a loss
EXECUTION_WINDOW_START=55      # scan late in the hour (minutes)
EXECUTION_WINDOW_END=59

# ── Economic calendar filter ────────────────────────────────────────────
NEWS_FILTER_ENABLED=true
NEWS_BLOCK_BEFORE_MINS=15
NEWS_BLOCK_AFTER_MINS=30

# ── Scholar (RL/LLM auto-tuning) — keep OFF for live trading ───────────
SCHOLAR_AUTO_TUNE=false

# ── Telegram alerts & remote control ────────────────────────────────────
TELEGRAM_BOT_TOKEN=            # from @BotFather
TELEGRAM_CHAT_ID=              # your chat id (only this id may command)
NOTIFY_DEBUG=false

# ── Gemini (only used when SCHOLAR_AUTO_TUNE=true) ──────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GEMINI_TEMPERATURE=0.7
GEMINI_MAX_TOKENS=2048

# ── Licensing / secrets (NEVER commit real values) ──────────────────────
ALADIN_DRM_KEY=                # master secret for license generation+validation
LICENSE_KEY=                   # client license (auto-validated at startup)

# ── Storage ─────────────────────────────────────────────────────────────
BOT_DB_PATH=db/trading_bot.db
